# -*- coding: utf-8 -*-
"""
Construction d'un fonds Article 9 SFDR (droit français / OPCVM) - MSCI World au 31/12/2024
Objectif durable : contribuer à la transition bas carbone (trajectoire de température <= 2°C)
Entrée  : all_data.csv      Sortie : portefeuille_fonds_article9.xlsx
"""
import numpy as np
import pandas as pd
from scipy.optimize import minimize

DATA = "all_data.csv"
OUT = "portefeuille_fonds_article9_V2.xlsx"

# ----------------------------------------------------------------------------
# PARAMETRES
# ----------------------------------------------------------------------------
N_TITRES = 35         # nombre de lignes visé
MAX_PAR_SECTEUR_SEL = 8     # nb max de titres par secteur GICS à la sélection
CAP_SECTEUR = 0.25          # poids max par secteur
W_MIN, W_MAX_STD = 0.01, 0.05   # plancher / plafond standard par ligne
W_MAX_TOP, N_TOP = 0.08, 4      # quelques lignes autorisées jusqu'à 8% (5/10/40 : 4x8% = 32% <= 40%)
TILT = 0.4                  # intensité du tilt qualité (score) sur la base "capitalisation"
ITR_MAX_PTF = 2.0           # température pondérée du portefeuille <= 2°C
PCT_EXCL = 0.80             # on exclut les 20% pires (percentile d'intensité > 0.8) par secteur

# Exclusions de type PAB (proxy sur les données disponibles)
IG_FOSSILES = ["Oil&Gas", "Oil&Gas Services", "Pipelines", "Mining", "Gas"]
SECTEURS_EXCL = ["Energy"]

d = pd.read_csv(DATA)
d["Intensite S1+S2"] = d["INTENSITY_SCOPE_1"] + d["INTENSITY_SCOPE_2"]
for k in (1, 2, 3):   # percentile d'intensité carbone au sein du secteur GICS
    d[f"SCOPE_{k}_PCT_SECTEUR"] = d.groupby("gics_sector_name")[f"INTENSITY_SCOPE_{k}"].rank(pct=True)
d["LCT_PCT_SECTEUR"] = d.groupby("gics_sector_name")["CBN_LCT_SCORE"].rank(pct=True)

# ----------------------------------------------------------------------------
# ENTONNOIR DE FILTRES  (colonne, opérateur, seuil, libellé, famille)
# ----------------------------------------------------------------------------
cols_requises = ["ITR", "S1_ITR", "S2_ITR", "S3_ITR", "INTENSITY_SCOPE_1", "INTENSITY_SCOPE_2",
                 "INTENSITY_SCOPE_3", "CBN_LCT_SCORE", "ENVIRONMENT_CONTROVERSY_SCORE",
                 "SOCIAL_CONTROVERSY_SCORE", "GOVERNANCE_CONTROVERSY_SCORE", "GOVERNANCE_PILLAR_SCORE", "IVA_COMPANY_RATING",
                 "SDG_05_NET_ALIGNMENT_SCORE", "SDG_13_NET_ALIGNMENT_SCORE", "SDG_14_NET_ALIGNMENT_SCORE",
                 "SDG_15_NET_ALIGNMENT_SCORE", "ROIC", "Debt assets", "Sharpe 10Y"]

# Rating ESG minimum BB
rating_rank = ["BB","BBB","A","AA","AAA"]

etapes = [
    ("Univers : MSCI World (Developed Markets)", lambda x: x.index == x.index, "Univers"),
    ("Exclusions PAB : tabac, armes controversées, secteur Energie, pétrole/gaz/charbon/mines",
     lambda x: (x.TOB_PRODUCER.fillna(0) != 1) & (x.CWEAP_TIE.fillna(0) != 1)
               & (~x.industry_group.isin(IG_FOSSILES)) & (~x.gics_sector_name.isin(SECTEURS_EXCL)), "Exclusion"),
    ("Exclusion des actifs sans données extra-financières / financières clés",
     lambda x: x[cols_requises].notna().all(axis=1), "Données"),
    ("Intensité Scope 1/2/3 : 20% pires de chaque secteur exclus (percentile <= 0.8)",
     lambda x: (x.SCOPE_1_PCT_SECTEUR <= PCT_EXCL) & (x.SCOPE_2_PCT_SECTEUR <= PCT_EXCL)
               & (x.SCOPE_3_PCT_SECTEUR <= PCT_EXCL), "Climat"),
    ("DNSH environnement : controverses environnementales (0-10) >= 7",
     lambda x: x.ENVIRONMENT_CONTROVERSY_SCORE >= 7, "DNSH"),
    ("Note ESG >= BB et controverses gouvernance >= 7 et pilier G >= 5",
     lambda x: (u["IVA_COMPANY_RATING"].isin(rating_rank)) & (x.GOVERNANCE_CONTROVERSY_SCORE >= 7) & (x.GOVERNANCE_PILLAR_SCORE >= 5), "Gouvernance"),
    ("DNSH social : controverses sociales >= 4 et ODD 5 >= 2",
     lambda x: (x.SOCIAL_CONTROVERSY_SCORE >= 4) & (x.SDG_05_NET_ALIGNMENT_SCORE >= 2), "DNSH social"),
    ("DNSH climat/biodiversité : ODD 13, 14, 15 sans impact net négatif (>= 2)",
     lambda x: (x.SDG_13_NET_ALIGNMENT_SCORE >= 2) & (x.SDG_14_NET_ALIGNMENT_SCORE >= 2)
               & (x.SDG_15_NET_ALIGNMENT_SCORE >= 2), "DNSH"),
    ("Contribution : score transition bas carbone au-dessus de la médiane du secteur",
     lambda x: (x.LCT_PCT_SECTEUR >= 0.5), "Contribution"),
    ("Filtre financier : ROIC > 0, Dette/actifs <= 45%, Sharpe 10 ans > 0.3",
     lambda x: (x.ROIC > 0) & (x["Debt assets"] <= 45) & (x["Sharpe 10Y"] > 0.3), "Financier"),
]
u, entonnoir = d.copy(), []
for lib, f, _ in etapes:
    u = u[f(u)]
    entonnoir.append((lib, len(u)))
cand = u.copy()

# ----------------------------------------------------------------------------
# SCORE & SELECTION (diversifiée : max N titres par secteur)
# ----------------------------------------------------------------------------
def z(s):
    s = s.clip(s.quantile(0.01), s.quantile(0.99))
    return (s - s.mean()) / s.std(ddof=0)

cand["score"] = (z(cand["Sharpe 10Y"]) + z(cand["ROIC"]) + z(cand["Annualized return 5Y"])
                 + z(cand["CBN_LCT_SCORE"]) - z(cand["Intensite S1+S2"]) - z(cand["ITR"])
                 + z(cand["SDG_13_NET_ALIGNMENT_SCORE"])) / 7
cand = cand.sort_values("score", ascending=False)
cand["rang_secteur"] = cand.groupby("gics_sector_name").cumcount() + 1
sel = cand[cand.rang_secteur <= MAX_PAR_SECTEUR_SEL].head(N_TITRES).copy().reset_index(drop=True)

# ----------------------------------------------------------------------------
# PONDERATION : base capitalisation (racine du poids MSCI) x tilt qualité,
# puis projection sous contraintes (5/10/40, secteur, ITR)
# ----------------------------------------------------------------------------
n = len(sel)
w0 = np.sqrt(sel["Weight in MSCI World"].values) * np.exp(TILT * sel["score"].values / sel["score"].std())
w0 = w0 / w0.sum()
top = np.argsort(-w0)[:N_TOP]
bornes = [(W_MIN, W_MAX_TOP if i in top else W_MAX_STD) for i in range(n)]
secteurs = sel["gics_sector_name"].values
cons = [{"type": "eq", "fun": lambda w: w.sum() - 1},
        {"type": "ineq", "fun": lambda w: ITR_MAX_PTF - w @ sel["ITR"].values}]
for s in np.unique(secteurs):
    m = (secteurs == s).astype(float)
    cons.append({"type": "ineq", "fun": lambda w, m=m: CAP_SECTEUR - w @ m})
print("Nombre de titres sélectionnés :", len(u))
print("Nombre de poids initiaux :", len(w0))
print("Nombre de bornes :", len(bornes))
print("Bornes :", bornes)


res = minimize(lambda w: np.sum((w - w0) ** 2 / w0), w0, bounds=bornes, constraints=cons, method="SLSQP",
               options={"maxiter": 1000, "ftol": 1e-12})
assert res.success, res.message
sel["Poids dans le fonds"] = res.x / res.x.sum()
sel = sel.sort_values("Poids dans le fonds", ascending=False).reset_index(drop=True)
w = sel["Poids dans le fonds"].values

# ----------------------------------------------------------------------------
# KPI : fonds vs MSCI World (moyennes pondérées, poids renormalisés sur données disponibles)
# ----------------------------------------------------------------------------
def wavg(df, col, wcol):
    m = df[col].notna() & df[wcol].notna()
    return np.average(df.loc[m, col], weights=df.loc[m, wcol]) if m.any() else np.nan

sel["w_f"] = sel["Poids dans le fonds"]
d["w_b"] = d["Weight in MSCI World"]
kpis = [("ITR (°C)", "ITR"), ("ITR Scope 1 (°C)", "S1_ITR"), ("ITR Scope 2 (°C)", "S2_ITR"),
        ("ITR Scope 3 (°C)", "S3_ITR"), ("Score transition bas carbone", "CBN_LCT_SCORE"),
        ("Intensité carbone S1 (tCO2e/M$ CA)", "INTENSITY_SCOPE_1"),
        ("Intensité carbone S2", "INTENSITY_SCOPE_2"), ("Intensité carbone S3", "INTENSITY_SCOPE_3"),
        ("CA aligné Taxonomie UE (%)", "EST_EU_TAXONOMY_MAX_REV"), ("CA technologies propres (%)", "CT_TOTAL_MAX_REV"),
        ("Score Environnement", "ENVIRONMENTAL_PILLAR_SCORE"), ("Score Social", "SOCIAL_PILLAR_SCORE"),
        ("Score Gouvernance", "GOVERNANCE_PILLAR_SCORE"),
        ("Controverses env.", "ENVIRONMENT_CONTROVERSY_SCORE"), ("Controverses sociales", "SOCIAL_CONTROVERSY_SCORE"),
        ("Controverses gouvernance", "GOVERNANCE_CONTROVERSY_SCORE"),
        ("Alignement ODD 5", "SDG_05_NET_ALIGNMENT_SCORE"), ("Alignement ODD 7", "SDG_07_NET_ALIGNMENT_SCORE"),
        ("Alignement ODD 9", "SDG_09_NET_ALIGNMENT_SCORE"), ("Alignement ODD 13", "SDG_13_NET_ALIGNMENT_SCORE"),
        ("Alignement ODD 14", "SDG_14_NET_ALIGNMENT_SCORE"), ("Alignement ODD 15", "SDG_15_NET_ALIGNMENT_SCORE"),
        ("Rdt annualisé 1 an", "Annualized return 1Y"), ("Rdt annualisé 5 ans", "Annualized return 5Y"),
        ("Rdt annualisé 10 ans", "Annualized return 10Y"), ("Rdt annualisé 20 ans", "Annualized return 20Y"),
        ("Volatilité 5 ans (moy. pondérée)", "Volatility 5Y"), ("Sharpe 5 ans", "Sharpe 5Y"),
        ("Sharpe 10 ans", "Sharpe 10Y"), ("Max drawdown 5 ans (moy.)", "Max drawdown 5Y"),
        ("ROIC (%)", "ROIC"), ("Dette/actifs (%)", "Debt assets")]
rows = []
for lib, c in kpis:
    f, b = wavg(sel, c, "w_f"), wavg(d, c, "w_b")
    rows.append([lib, f, b, f - b])
kpi = pd.DataFrame(rows, columns=["Indicateur", "Fonds", "MSCI World", "Écart vs MSCI World"])

# ----------------------------------------------------------------------------
# CONTROLES REGLEMENTAIRES (OPCVM 5/10/40, SFDR Art. 9, nom du fonds / PAB)
# ----------------------------------------------------------------------------
eur = sel["region_en"] == "Europe"
ctrl = pd.DataFrame([
    ["Nombre de lignes", len(sel), "OK" if len(sel) >= 20 else "A revoir"],
    ["Poids max d'une ligne (<= 10%)", w.max(), "OK" if w.max() <= 0.10 + 1e-9 else "KO"],
    ["Somme des lignes > 5% (<= 40%)", w[w > 0.05].sum(), "OK" if w[w > 0.05].sum() <= 0.40 + 1e-9 else "KO"],
    ["Somme des poids", w.sum(), "OK" if abs(w.sum() - 1) < 1e-9 else "KO"],
    ["Poids min d'une ligne", w.min(), "OK"],
    ["Poids max d'un secteur (<= 25%)", sel.groupby("gics_sector_name")["w_f"].sum().max(),
     "OK" if sel.groupby("gics_sector_name")["w_f"].sum().max() <= CAP_SECTEUR + 1e-9 else "KO"],
    ["Température pondérée du portefeuille (<= 2°C)", float(w @ sel["ITR"]), "OK" if w @ sel["ITR"] <= 2 else "KO"],
    ["Part Europe", sel.loc[eur, "w_f"].sum(), "Info"],
    ["Nombre de titres européens", int(eur.sum()), "Info"],
    ["Poids max pays", sel.groupby("country")["w_f"].sum().max(), "Info"],
    ["Part tabac / armes controversées / fossiles (PAB)",
     sel.loc[(sel.TOB_PRODUCER == 1) | (sel.CWEAP_TIE == 1) | sel.industry_group.isin(IG_FOSSILES)
             | sel.gics_sector_name.isin(SECTEURS_EXCL), "w_f"].sum(), "OK"],
    ["Part investissements durables (lignes passant tous les filtres)", 1.0, "OK (100% >= 80% requis nom ESMA)"],
    ["Part CA aligné Taxonomie (moy. pondérée, %)", wavg(sel, "EST_EU_TAXONOMY_MAX_REV", "w_f"),
     "Info (non requis : objectif = transition bas carbone)"],
], columns=["Contrôle", "Valeur", "Statut"])

# ----------------------------------------------------------------------------
# AUTRES TABLEAUX
# ----------------------------------------------------------------------------
def repartition(col):
    a = sel.groupby(col)["w_f"].sum()
    b = d.groupby(col)["w_b"].sum()
    t = pd.concat([a, b], axis=1).fillna(0)
    t.columns = ["Fonds", "MSCI World"]
    return t.sort_values("Fonds", ascending=False).reset_index().rename(columns={"index": col})
secteurs_t, pays_t, ig_t = repartition("gics_sector_name"), repartition("country"), None
pays_t = pays_t[pays_t.Fonds > 0]

metriques = ["ITR", "CBN_LCT_SCORE", "Intensite S1+S2", "SDG_13_NET_ALIGNMENT_SCORE", "ENVIRONMENT_CONTROVERSY_SCORE",
             "GOVERNANCE_CONTROVERSY_SCORE", "GOVERNANCE_PILLAR_SCORE", "ROIC", "Debt assets", "Sharpe 10Y"]
corr = cand[metriques].corr().round(2).reset_index().rename(columns={"index": "Métrique"})

criteres = pd.DataFrame([
    ["TOB_PRODUCER / CWEAP_TIE", "!=", 1, "Exclusion tabac et armes controversées", "Exclusion PAB"],
    ["gics_sector / industry_group", "hors", "Energie, Oil&Gas, Pipelines, Gas, Mining", "Exclusion pétrole, gaz, charbon (proxy PAB)", "Exclusion PAB"],
    ["ITR (portefeuille pondéré)", "<=", 2.0, "Contrainte au niveau du portefeuille (optimisation), pas par titre", "Climat"],
    ["SCOPE_1/2/3_PCT_SECTEUR", "<=", PCT_EXCL, "Intensité carbone : 20% pires du secteur exclus", "Climat"],
    ["ENVIRONMENT_CONTROVERSY_SCORE", ">=", 7, "Controverses environnementales (0-10)", "DNSH"],
    ["GOVERNANCE_CONTROVERSY_SCORE", ">=", 7, "Controverses de gouvernance (0-10)", "Gouvernance"],
    ["GOVERNANCE_PILLAR_SCORE", ">=", 5, "Pilier gouvernance", "Gouvernance"],
    ["SOCIAL_CONTROVERSY_SCORE", ">=", 4, "Controverses sociales (0-10)", "DNSH social"],
    ["SDG_05_NET_ALIGNMENT_SCORE", ">=", 2, "ODD 5 : pas d'impact net négatif", "DNSH social"],
    ["SDG_13/14/15_NET_ALIGNMENT_SCORE", ">=", 2, "ODD 13, 14, 15 : pas d'impact net négatif", "DNSH climat / biodiversité"],
    ["CBN_LCT_SCORE", ">=", 5.5, "Score transition bas carbone (+ > médiane du secteur)", "Contribution"],
    ["ROIC", ">", 0, "Rentabilité du capital investi", "Financier"],
    ["Debt assets", "<=", 45, "Dette / actifs (%)", "Financier"],
    ["Sharpe 10Y", ">", 0.3, "Sharpe 10 ans", "Financier"],
], columns=["Colonne", "Opérateur", "Seuil", "Libellé", "Famille"])

ptf = sel[["ticker", "name", "isin", "country", "gics_sector_name", "industry_group", "Poids dans le fonds",
           "Weight in MSCI World", "score", "ITR", "CBN_LCT_SCORE", "Intensite S1+S2",
           "SDG_13_NET_ALIGNMENT_SCORE", "ENVIRONMENT_CONTROVERSY_SCORE", "SOCIAL_CONTROVERSY_SCORE",
           "GOVERNANCE_PILLAR_SCORE", "ROIC", "Debt assets", "Sharpe 10Y", "Annualized return 5Y",
           "Volatility 5Y"]].rename(columns={"Weight in MSCI World": "Poids MSCI World",
                                             "gics_sector_name": "secteur"})
ent = pd.DataFrame(entonnoir, columns=["Etape", "Entreprises restantes"])

with pd.ExcelWriter(OUT, engine="openpyxl") as xw:
    for nom, df in [("Portefeuille", ptf), ("Entonnoir de filtres", ent), ("Criteres", criteres),
                    ("KPI vs MSCI World", kpi), ("Controles reglementaires", ctrl),
                    ("Secteurs", secteurs_t), ("Pays", pays_t), ("Correlations metriques", corr)]:
        df.to_excel(xw, sheet_name=nom, index=False)
        ws = xw.sheets[nom]
        for c in ws[1]:
            c.font = c.font.copy(bold=True)
        for col in ws.columns:
            ws.column_dimensions[col[0].column_letter].width = min(70, max(12, max(len(str(c.value or "")) for c in col) + 2))
        for row in ws.iter_rows(min_row=2):
            for c in row:
                if isinstance(c.value, float):
                    c.number_format = "0.0000" if c.column <= 8 and nom == "Portefeuille" else "0.00"
    ws = xw.sheets["Portefeuille"]
    for r in range(2, len(ptf) + 2):
        ws.cell(r, 7).number_format = "0.00%"; ws.cell(r, 8).number_format = "0.000%"

print(ent.to_string(index=False)); print(ptf[["name", "secteur", "Poids dans le fonds"]].to_string())
print(ctrl.to_string(index=False)); print(kpi.round(3).to_string(index=False))
